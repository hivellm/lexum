    /// Test input validation
    async fn test_input_validation(&self, results: &mut SecurityTestResults) -> Result<()> {
        println!("🔍 Testing input validation");
        results.tests_run += 1;

        let malicious_inputs = vec![
            ("index_name", "A".repeat(10000)),   // Very long input
            ("index_name", "".to_string()),                  // Empty input
            ("index_name", "index with spaces".to_string()), // Spaces in input
            ("index_name", "index-with-special-chars!@#$%^&*()".to_string()), // Special characters
            ("index_name", "index\nwith\nnewlines".to_string()), // Newlines in input
            ("index_name", "index\twith\ttabs".to_string()), // Tabs in input
        ];

        let mut vulnerabilities = Vec::new();

        for (field, value) in malicious_inputs {
            let response = self
                .client
                .post(&format!("{}/api/indices", self.config.server_url))
                .json(&json!({
                    field: value
                }))
                .send()
                .await?;

            if response.status().is_success() {
                vulnerabilities.push(format!(
                    "Input validation bypass for field '{}' with value: {}",
                    field, value
                ));
            }
        }

        if vulnerabilities.is_empty() {
            results.tests_passed += 1;
            println!("  ✅ Input validation test passed");
        } else {
            results.tests_failed += 1;
            results.vulnerabilities_found.extend(vulnerabilities);
            println!("  ❌ Input validation vulnerabilities found");
        }

        Ok(())
    }

    /// Test rate limiting
    async fn test_rate_limiting(&self, results: &mut SecurityTestResults) -> Result<()> {
        println!("🔍 Testing rate limiting");
        results.tests_run += 1;

        let mut requests_sent = 0;
        let mut rate_limited = false;

        // Send rapid requests to test rate limiting
        for _ in 0..100 {
            let response = self
                .client
                .get(&format!("{}/api/search", self.config.server_url))
                .query(&[("q", "test")])
                .send()
                .await?;

            requests_sent += 1;

            if response.status() == 429 {
                rate_limited = true;
                break;
            }

            sleep(Duration::from_millis(10)).await;
        }

        if rate_limited {
            results.tests_passed += 1;
            println!(
                "  ✅ Rate limiting test passed (rate limited after {} requests)",
                requests_sent
            );
        } else {
            results.tests_failed += 1;
            results
                .vulnerabilities_found
                .push("Rate limiting not implemented or too permissive".to_string());
            println!("  ❌ Rate limiting test failed (no rate limiting detected)");
        }

        Ok(())
    }

    /// Test CORS policy
    async fn test_cors_policy(&self, results: &mut SecurityTestResults) -> Result<()> {
        println!("🔍 Testing CORS policy");
        results.tests_run += 1;

        let response = self
            .client
            .get(&format!("{}/api/search", self.config.server_url))
            .header("Origin", "https://malicious-site.com")
            .send()
            .await?;

        let headers = response.headers();
        let cors_origin = headers.get("Access-Control-Allow-Origin");

        if let Some(origin) = cors_origin {
            if origin == "*" {
                results.tests_failed += 1;
                results
                    .vulnerabilities_found
                    .push("CORS policy allows all origins (*)".to_string());
                println!("  ❌ CORS policy test failed (allows all origins)");
            } else {
                results.tests_passed += 1;
                println!("  ✅ CORS policy test passed (restricted origins)");
            }
        } else {
            results.tests_passed += 1;
            println!("  ✅ CORS policy test passed (no CORS headers)");
        }

        Ok(())
    }

    /// Test Content Security Policy
    async fn test_content_security_policy(&self, results: &mut SecurityTestResults) -> Result<()> {
        println!("🔍 Testing Content Security Policy");
        results.tests_run += 1;

        let response = self
            .client
            .get(&format!("{}/api/search", self.config.server_url))
            .send()
            .await?;

        let headers = response.headers();
        let csp = headers.get("Content-Security-Policy");

        if csp.is_none() {
            results.tests_failed += 1;
            results
                .vulnerabilities_found
                .push("Content Security Policy not implemented".to_string());
            println!("  ❌ CSP test failed (no CSP header)");
        } else {
            results.tests_passed += 1;
            println!("  ✅ CSP test passed (CSP header present)");
        }

        Ok(())
    }

    /// Test HTTPS enforcement
    async fn test_https_enforcement(&self, results: &mut SecurityTestResults) -> Result<()> {
        println!("🔍 Testing HTTPS enforcement");
        results.tests_run += 1;

        let response = self
            .client
            .get(&format!("{}/api/search", self.config.server_url))
            .send()
            .await?;

        let headers = response.headers();
        let hsts = headers.get("Strict-Transport-Security");

        if hsts.is_none() {
            results.tests_failed += 1;
            results
                .vulnerabilities_found
                .push("HTTPS enforcement not implemented (no HSTS header)".to_string());
            println!("  ❌ HTTPS enforcement test failed (no HSTS header)");
        } else {
            results.tests_passed += 1;
            println!("  ✅ HTTPS enforcement test passed (HSTS header present)");
        }

        Ok(())
    }

    /// Test information disclosure
    async fn test_information_disclosure(&self, results: &mut SecurityTestResults) -> Result<()> {
        println!("🔍 Testing information disclosure");
        results.tests_run += 1;

        let sensitive_endpoints = vec![
            "/.env",
            "/config.json",
            "/.git/config",
            "/admin",
            "/debug",
            "/status",
            "/health",
            "/metrics",
        ];

        let mut vulnerabilities = Vec::new();

        for endpoint in sensitive_endpoints {
            let response = self
                .client
                .get(&format!("{}{}", self.config.server_url, endpoint))
                .send()
                .await?;

            if response.status().is_success() {
                let body = response.text().await?;
                if body.contains("password") || body.contains("secret") || body.contains("key") {
                    vulnerabilities.push(format!(
                        "Sensitive information disclosed at endpoint: {}",
                        endpoint
                    ));
                }
            }
        }

        if vulnerabilities.is_empty() {
            results.tests_passed += 1;
            println!("  ✅ Information disclosure test passed");
        } else {
            results.tests_failed += 1;
            results.vulnerabilities_found.extend(vulnerabilities);
            println!("  ❌ Information disclosure vulnerabilities found");
        }

        Ok(())
    }

    /// Test DoS attacks
    async fn test_dos_attacks(&self, results: &mut SecurityTestResults) -> Result<()> {
        println!("🔍 Testing DoS attack resistance");
        results.tests_run += 1;

        let mut requests_sent = 0;
        let mut successful_requests = 0;

        // Send many concurrent requests
        let mut handles = Vec::new();

        for _ in 0..50 {
            let client = self.client.clone();
            let url = format!("{}/api/search", self.config.server_url);

            let handle = tokio::spawn(async move {
                let response = client.get(&url).query(&[("q", "test")]).send().await;

                response.is_ok()
            });

            handles.push(handle);
        }

        for handle in handles {
            if handle.await? {
                successful_requests += 1;
            }
            requests_sent += 1;
        }

        let success_rate = if requests_sent > 0 {
            (successful_requests as f64 / requests_sent as f64) * 100.0
        } else {
            0.0
        };

        if success_rate > 80.0 {
            results.tests_passed += 1;
            println!(
                "  ✅ DoS resistance test passed ({}% success rate)",
                success_rate
            );
        } else {
            results.tests_failed += 1;
            results.vulnerabilities_found.push(format!(
                "DoS vulnerability detected ({}% success rate)",
                success_rate
            ));
            println!(
                "  ❌ DoS resistance test failed ({}% success rate)",
                success_rate
            );
        }

        Ok(())
    }
}

/// Test SQL injection vulnerabilities
#[tokio::test]
async fn test_sql_injection_security() -> Result<()> {
    let config = SecurityTestConfig::default();
    let runner = SecurityTestRunner::new(config)?;

    let mut results = SecurityTestResults {
        tests_run: 0,
        tests_passed: 0,
        tests_failed: 0,
        vulnerabilities_found: Vec::new(),
        security_score: 0.0,
    };

    runner.test_sql_injection(&mut results).await?;

    assert!(results.tests_passed > 0, "SQL injection test should pass");
    assert!(
        results.vulnerabilities_found.is_empty(),
        "No SQL injection vulnerabilities should be found"
    );

    Ok(())
}

