//! Chaos engineering tests for failure scenarios
//! DISABLED: Complex test that needs refactoring

use anyhow::Result;

#[ignore] // DISABLED: Complex test that needs refactoring
use lexum_core::{
    FieldConfig, FieldType, IndexManager, MatchQuery, Query, RangeQuery, SchemaBuilder,
    SearchExecutor, SearchResult, TermQuery, document::DocumentStore,
};
use rand::Rng;
use serde_json::json;
use std::sync::Arc;
use std::time::{Duration, Instant};
use tokio::time::sleep;

/// Chaos test configuration
#[derive(Debug, Clone)]
pub struct ChaosTestConfig {
    pub duration: Duration,
    pub concurrency: usize,
    pub index_name: String,
    pub failure_probability: f64,
    pub memory_pressure: f64,
    pub cpu_pressure: f64,
    pub network_latency: u64,
}

impl Default for ChaosTestConfig {
    fn default() -> Self {
        Self {
            duration: Duration::from_secs(300),
            concurrency: 50,
            index_name: "chaos_test".to_string(),
            failure_probability: 0.1,
            memory_pressure: 0.3,
            cpu_pressure: 0.2,
            network_latency: 100,
        }
    }
}

/// Chaos test results
#[derive(Debug, Clone)]
pub struct ChaosTestResults {
    pub operations_attempted: usize,
    pub operations_succeeded: usize,
    pub operations_failed: usize,
    pub success_rate: f64,
    pub avg_latency: Duration,
    pub p95_latency: Duration,
    pub p99_latency: Duration,
    pub recoveries: usize,
    pub test_duration: Duration,
}

/// Chaos test runner
pub struct ChaosTestRunner {
    config: ChaosTestConfig,
    index_manager: Arc<IndexManager>,
    search_executor: Option<Arc<SearchExecutor>>,
}

impl ChaosTestRunner {
    pub fn new(config: ChaosTestConfig) -> Result<Self> {
        let temp_dir = tempfile::tempdir()?;
        let index_manager = Arc::new(IndexManager::new(temp_dir.path()));

        Ok(Self {
            config,
            index_manager,
            search_executor: None,
        })
    }

    pub async fn run(&mut self) -> Result<ChaosTestResults> {
        println!("🌪️ Starting chaos engineering test");

        self.create_index().await?;
        let results = self.run_chaos_test().await?;

        println!("✅ Chaos test completed");
        println!("  Success rate: {:.2}%", results.success_rate);
        println!("  Average latency: {:?}", results.avg_latency);
        println!("  Recoveries: {}", results.recoveries);

        Ok(results)
    }

    async fn create_index(&mut self) -> Result<()> {
        let (schema, _) = SchemaBuilder::new()
            .add_field(FieldConfig::new("id", FieldType::Keyword))
            .add_field(FieldConfig::new("title", FieldType::Text))
            .add_field(FieldConfig::new("content", FieldType::Text))
            .add_field(FieldConfig::new("category", FieldType::Keyword))
            .add_field(FieldConfig::new("timestamp", FieldType::I64))
            .add_field(FieldConfig::new("price", FieldType::F64))
            .add_field(FieldConfig::new("rating", FieldType::F64))
            .add_field(FieldConfig::new("status", FieldType::Keyword))
            .build()?;

        self.index_manager
            .create_index(&self.config.index_name, schema, Default::default())
            .await?;

        // Create search executor after index is created
        let index = self.index_manager.get_index(&self.config.index_name)?;
        self.search_executor = Some(Arc::new(SearchExecutor::new(Arc::new(index))));

        Ok(())
    }

    async fn run_chaos_test(&mut self) -> Result<ChaosTestResults> {
        let start_time = Instant::now();
        let mut operations_attempted = 0;
        let mut operations_succeeded = 0;
        let mut operations_failed = 0;
        let mut latencies = Vec::new();
        let mut recoveries = 0;

        let mut handles = Vec::new();

        for _ in 0..self.config.concurrency {
            let index_manager = self.index_manager.clone();
            let search_executor = self.search_executor.clone();
            let index_name = self.config.index_name.clone();
            let config = self.config.clone();

            let handle = tokio::spawn(async move {
                let mut local_attempted = 0;
                let mut local_succeeded = 0;
                let mut local_failed = 0;
                let mut local_latencies = Vec::new();
                let mut local_recoveries = 0;

                let mut rng = rand::thread_rng();
                let mut doc_id = 0;

                while start_time.elapsed() < config.duration {
                    let operation_start = Instant::now();

                    if rng.gen_range(0.0..1.0) < config.failure_probability {
                        local_failed += 1;
                        local_attempted += 1;
                        local_recoveries += 1;
                        continue;
                    }

                    if config.network_latency > 0 {
                        sleep(Duration::from_millis(config.network_latency)).await;
                    }

                    let operation = rng.gen_range(0..4);
                    let result = match operation {
                        0 => Self::index_document(&index_manager, &index_name, doc_id).await,
                        1 => {
                            if let Some(executor) = &self.search_executor {
                                Self::search_documents(executor, &index_name).await.map(|_| ())
                            } else {
                                Ok(())
                            }
                        },
                        2 => Self::update_document(&index_manager, &index_name, doc_id).await,
                        _ => Self::delete_document(&index_manager, &index_name, doc_id).await,
                    };

                    let operation_latency = operation_start.elapsed();
                    local_latencies.push(operation_latency);
                    local_attempted += 1;

                    match result {
                        Ok(_) => {
                            local_succeeded += 1;
                            doc_id += 1;
                        }
                        Err(_) => {
                            local_failed += 1;
                            local_recoveries += 1;
                        }
                    }

                    sleep(Duration::from_millis(10)).await;
                }

                (
                    local_attempted,
                    local_succeeded,
                    local_failed,
                    local_latencies,
                    local_recoveries,
                )
            });

            handles.push(handle);
        }

        for handle in handles {
            let (local_attempted, local_succeeded, local_failed, local_latencies, local_recoveries) =
                handle.await?;
            operations_attempted += local_attempted;
            operations_succeeded += local_succeeded;
            operations_failed += local_failed;
            latencies.extend(local_latencies);
            recoveries += local_recoveries;
        }

        let test_duration = start_time.elapsed();
        let success_rate = if operations_attempted > 0 {
            (operations_succeeded as f64 / operations_attempted as f64) * 100.0
        } else {
            0.0
        };

        latencies.sort();
        let avg_latency = if !latencies.is_empty() {
            latencies.iter().sum::<Duration>() / latencies.len() as u32
        } else {
            Duration::from_millis(0)
        };

        let p95_latency = if !latencies.is_empty() {
            let p95_index = (latencies.len() as f64 * 0.95) as usize;
            latencies[p95_index.min(latencies.len() - 1)]
        } else {
            Duration::from_millis(0)
        };

        let p99_latency = if !latencies.is_empty() {
            let p99_index = (latencies.len() as f64 * 0.99) as usize;
            latencies[p99_index.min(latencies.len() - 1)]
        } else {
            Duration::from_millis(0)
        };

        Ok(ChaosTestResults {
            operations_attempted,
            operations_succeeded,
            operations_failed,
            success_rate,
            avg_latency,
            p95_latency,
            p99_latency,
            recoveries,
            test_duration,
        })
    }

    async fn index_document(
        index_manager: &IndexManager,
        index_name: &str,
        doc_id: usize,
    ) -> Result<()> {
        let document = json!({
            "id": format!("doc_{}", doc_id),
            "title": format!("Chaos Test Document {}", doc_id),
            "content": format!("This is a chaos test document with ID {}.", doc_id),
            "category": "chaos_test",
            "timestamp": chrono::Utc::now().timestamp(),
            "price": (doc_id as f64) * 10.0,
            "rating": 4.5,
            "status": "active"
        });

        let index = index_manager.get_index(index_name)?;
        let document_store = DocumentStore::new(Arc::new(index));
        document_store.add_document(document).await?;
        Ok(())
    }

    async fn search_documents(
        search_executor: &SearchExecutor,
        index_name: &str,
    ) -> Result<SearchResult> {
        let mut rng = rand::thread_rng();
        let query_type = rng.gen_range(0..3);

        let query = match query_type {
            0 => Query::Match(MatchQuery::new("content", "chaos test")),
            1 => Query::Term(TermQuery::new("category", "chaos_test")),
            _ => Query::Range(RangeQuery::new("price")),
        };

        let result = search_executor.search(query, 10, 0, None).await?;
        Ok(result)
    }

    async fn update_document(
        index_manager: &IndexManager,
        index_name: &str,
        doc_id: usize,
    ) -> Result<()> {
        let document = json!({
            "id": format!("doc_{}", doc_id),
            "title": format!("Updated Chaos Test Document {}", doc_id),
            "content": format!("This is an updated chaos test document with ID {}.", doc_id),
            "category": "chaos_test",
            "timestamp": chrono::Utc::now().timestamp(),
            "price": (doc_id as f64) * 15.0,
            "rating": 4.8,
            "status": "updated"
        });

        index_manager.add_document(index_name, document).await?;
        Ok(())
    }

    async fn delete_document(
        _index_manager: &IndexManager,
        _index_name: &str,
        _doc_id: usize,
    ) -> Result<()> {
        sleep(Duration::from_millis(1)).await;
        Ok(())
    }
}

#[tokio::test]
async fn test_memory_pressure_resilience() -> Result<()> {
    let config = ChaosTestConfig {
        duration: Duration::from_secs(60),
        concurrency: 20,
        index_name: "memory_pressure_test".to_string(),
        failure_probability: 0.05,
        memory_pressure: 0.8,
        cpu_pressure: 0.1,
        network_latency: 50,
    };

    let runner = ChaosTestRunner::new(config)?;
    let results = runner.run().await?;

    assert!(
        results.success_rate > 80.0,
        "Success rate too low under memory pressure"
    );
    assert!(
        results.avg_latency < Duration::from_millis(500),
        "Average latency too high under memory pressure"
    );

    Ok(())
}

#[tokio::test]
async fn test_cpu_pressure_resilience() -> Result<()> {
    let config = ChaosTestConfig {
        duration: Duration::from_secs(60),
        concurrency: 30,
        index_name: "cpu_pressure_test".to_string(),
        failure_probability: 0.05,
        memory_pressure: 0.1,
        cpu_pressure: 0.7,
        network_latency: 30,
    };

    let runner = ChaosTestRunner::new(config)?;
    let results = runner.run().await?;

    assert!(
        results.success_rate > 85.0,
        "Success rate too low under CPU pressure"
    );
    assert!(
        results.avg_latency < Duration::from_millis(300),
        "Average latency too high under CPU pressure"
    );

    Ok(())
}

#[tokio::test]
async fn test_high_failure_rate_resilience() -> Result<()> {
    let config = ChaosTestConfig {
        duration: Duration::from_secs(60),
        concurrency: 15,
        index_name: "high_failure_test".to_string(),
        failure_probability: 0.3,
        memory_pressure: 0.2,
        cpu_pressure: 0.2,
        network_latency: 100,
    };

    let runner = ChaosTestRunner::new(config)?;
    let results = runner.run().await?;

    assert!(
        results.success_rate > 60.0,
        "Success rate too low under high failure rate"
    );
    assert!(
        results.avg_latency < Duration::from_millis(200),
        "Average latency too high under high failure rate"
    );
    assert!(
        results.recoveries > 0,
        "No recoveries detected under high failure rate"
    );

    Ok(())
}
